# Copy to .gitmodules when a reusable app has a published remote.
# Until then those apps stay in this git (status: unpublished in config/modules.yaml).
#
#   cp .gitmodules.example .gitmodules
#   git submodule update --init --recursive
#
# [submodule "third_party/titan2-touchpadd/checkout"]
#     path = third_party/titan2-touchpadd/checkout
#     url = https://github.com/Abyss-c0re/titan2-touchpadd.git
