# Copy to config/misterztr.local.env (gitignored) and edit.
# MisterZtr-faithful source GSI — https://github.com/MisterZtr/LineageOS_gsi
# Product SoT: docs/project/SOURCE_PRODUCT.md
# Titan AOSP deltas: patches/gsi_source/ (applied after LineageOS_gsi patches)
# Do NOT put this tree inside the product git.

# Absolute path for the Android tree (outside product git)
MISTERZTR_TREE="${HOME}/Dev/titanus2-artifacts/misterztr_lineage"

# Branches (must match each other)
LINEAGE_BRANCH="lineage-23.2"
TREBLE_MANIFEST_BRANCH="lineage-23.2"
LINEAGE_GSI_REPO_BRANCH="lineage-23.2"

# VANILLA + EXT4 — product hybrid SoT
LUNCH_TARGET="lineage_arm64_bvN4-bp4a-userdebug"

# MisterZtr README uses -j4 for repo sync
REPO_JOBS=4
BUILD_JOBS="$(nproc)"

# SHALLOW_INIT=1 only if disk-starved (not in MisterZtr README)
SHALLOW_INIT=0

# Java 17 preferred (MisterZtr treble_app note)
# JAVA_HOME=/usr/lib/jvm/java-17-openjdk

USE_CCACHE=1
CCACHE_DIR="${HOME}/.ccache"
CCACHE_MAXSIZE=50G
