# Automatic IMS/MT setup once after boot. No SIM-property thrash (that re-ran setup constantly).
service titan2_ims_setup /system/bin/titan2-ims-setup.sh
    class late_start
    user root
    group root system radio
    oneshot
    disabled

# Vendor NVRAM resets persist.vendor.radio.simswitch to tray 1.
# Apply last Settings → Calls want as early as possible, then again after
# nvram Ready, so MMTEL is not created against the empty tray.
# persist.radio.titan2_simswitch is a boot-early cache of Settings → Calls.
# Early/hold re-read Settings once phone is up so a stale cache cannot win.
on post-fs-data
    exec -- /system/bin/titan2-ims-simswitch-early.sh

on property:vendor.service.nvram_init=Ready
    exec -- /system/bin/titan2-ims-simswitch-early.sh

on property:persist.radio.titan2_simswitch=*
    exec -- /system/bin/titan2-ims-simswitch-early.sh

# Vendor NVRAM overwrite is silent unless we watch the vendor key too.
# Early script is idempotent: same value → no setprop (no loop).
on property:persist.vendor.radio.simswitch=*
    exec -- /system/bin/titan2-ims-simswitch-early.sh

service titan2_ims_simswitch_early /system/bin/titan2-ims-simswitch-early.sh
    class core
    user root
    group root system radio
    oneshot

# Poll hold: NVRAM can rewrite vendor simswitch without a property event.
service titan2_ims_simswitch_hold /system/bin/titan2-ims-simswitch-hold.sh
    class late_start
    user root
    group root system radio

on property:sys.boot_completed=1
    start titan2_ims_setup
    start titan2_ims_simswitch_hold
