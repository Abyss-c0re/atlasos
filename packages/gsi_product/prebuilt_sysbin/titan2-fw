#!/system/bin/sh
# titan2-fw — ROM firewall cube CLI (UNDER any VPN)
#
# Cubes (real shell surfaces — no VpnService, no TUN claim):
#   fw-policy  → /data/misc/titan2/fw.* desire files
#   fw-engine  → Android fw_OUTPUT + private titan2_fw chain, owner uid match
#   fw-observe → C titan2-fw-observe (NDJSON) + shell fallback; live from/to
#   fw-ufw     → this CLI (+ bins/services/entities catalog incl. nanobot)
#   fw-policy  → fw.deny + fw.deny.bins + fw.deny.svcs + fw.protect
#
# Law: fail-open until enable. Never touch sys.usb / adbd / VpnService.
# SoT charter: docs/project/rd/CUBE_FIREWALL.md
#
export PATH=/system/bin:/system/xbin:/vendor/bin:$PATH

T2=/data/misc/titan2
ST=/data/local/tmp
DESIRE_EN=$T2/fw.enabled
DESIRE_DENY=$T2/fw.deny
DESIRE_BINS=$T2/fw.deny.bins
DESIRE_SVCS=$T2/fw.deny.svcs
PROTECT=$T2/fw.protect
CATALOG=$T2/fw.catalog
LIVE_RING=$ST/titan2_fw.live.ndjson
# if ST not writable (non-root hybrid), use atlas tmp
if ! touch "$ST/.fw_w" 2>/dev/null; then
  ST=/data/data/com.titanus2.atlas/files/reports/titan-loop/fixes/payloads/F-FW-LIVE/tmp
  mkdir -p "$ST" 2>/dev/null || true
  LIVE_RING=$ST/titan2_fw.live.ndjson
  LOCK=$ST/titan2_fw.lock
  STATUS_FILE=$ST/titan2_fw.status
fi
rm -f "$ST/.fw_w" 2>/dev/null || true
OBSERVE_C_CANDIDATES="/system/bin/titan2-fw-observe /data/adb/modules/titan2_fw/system/bin/titan2-fw-observe /data/local/tmp/titan2-fw-observe /data/data/com.titanus2.atlas/files/bin/titan2-fw-observe"
STATUS_FILE=$ST/titan2_fw.status
LOCK=$ST/titan2_fw.lock
CHAIN=titan2_fw
# Android netd / ConnectivityService hook (empty on Titan lab 2026-08-10)
PARENT=fw_OUTPUT
PARENT6=fw_OUTPUT
VER=0.3.2-cube

# Prefer /data/misc/titan2; fall back to tip path when unprivileged.
if ! mkdir -p "$T2" 2>/dev/null || ! touch "$T2/.w" 2>/dev/null; then
  T2=$ST/titan2_fw_desire
  mkdir -p "$T2" 2>/dev/null || true
  DESIRE_EN=$T2/fw.enabled
  DESIRE_DENY=$T2/fw.deny
  DESIRE_BINS=$T2/fw.deny.bins
  DESIRE_SVCS=$T2/fw.deny.svcs
  PROTECT=$T2/fw.protect
  CATALOG=$T2/fw.catalog
fi
rm -f "$T2/.w" 2>/dev/null || true

log() {
  mkdir -p "$ST" 2>/dev/null || true
  { echo "titan2-fw: $*" >>"$ST/titan2_fw.log"; } 2>/dev/null || true
}

_die() {
  echo "error: $*" >&2
  exit 1
}

_need_root() {
  id=$(id -u 2>/dev/null)
  [ "$id" = "0" ] || _die "need root (su). lab: adb shell su -c 'titan2-fw …'"
}

_write() {
  mkdir -p "$(dirname "$1")" 2>/dev/null || true
  { echo "$2" >"$1"; } 2>/dev/null || true
  chmod 666 "$1" 2>/dev/null || true
}

_lock() {
  mkdir -p "$ST" 2>/dev/null || true
  exec 9>"$LOCK" 2>/dev/null || return 0
  if command -v flock >/dev/null 2>&1; then
    flock 9 2>/dev/null || true
  fi
}

# ─── fw-policy ───────────────────────────────────────────────────────────────

policy_ensure() {
  mkdir -p "$T2" 2>/dev/null || true
  [ -f "$DESIRE_EN" ] || _write "$DESIRE_EN" "off"
  [ -f "$DESIRE_DENY" ] || : >"$DESIRE_DENY" 2>/dev/null || true
  [ -f "$DESIRE_BINS" ] || : >"$DESIRE_BINS" 2>/dev/null || true
  [ -f "$DESIRE_SVCS" ] || : >"$DESIRE_SVCS" 2>/dev/null || true
  if [ ! -f "$PROTECT" ]; then
    # Never auto-block these without FORCE=1 (commander plane)
    cat >"$PROTECT" <<'PROT'
nanobot
nanobot.real
atlas
com.titanus2.atlas
com.titanus2.controls
adbd
titan2-pad-agent
titan2-fw
titan2-fw-observe
PROT
  fi
  if [ ! -f "$CATALOG" ]; then
    cat >"$CATALOG" <<'CAT'
# kind key label
bin nanobot Nanobot peer (→ com.titanus2.nanobot)
bin nanobot.real Nanobot engine (→ com.titanus2.nanobot)
bin atlas Atlas hybrid (→ com.titanus2.atlas)
bin adbd ADB daemon
bin sshd SSH hybrid
bin titan2-fw Firewall CLI
bin titan2-fw-observe Live observe C
svc titan2-pad-agent Pad agent
svc titan2-usb-hid USB HID
svc titan2-kernel-cube Kernel cube
svc cameraserver Camera server (sensor privacy belt — not netfilter DROP)
svc camerahalserver Camera HAL (privacy belt)
pkg com.mediatek.ims MTK IMS (LOCATION_BYPASS+CAMERA — monitor/wrap)
pkg com.mediatek.gbaservice MTK GBA (SIM auth)
pkg com.android.DeviceAsWebcam Device as webcam
pkg com.android.devicediagnostics Device diagnostics
pkg com.mediatek.op08.ims OP08 IMS residual
pkg com.mediatek.op08.phone OP08 phone residual
svc titan2-display Subdisplay
svc titan2_volte_rcs_ua VoLTE RCS
pkg com.titanus2.atlas Atlas app
pkg com.titanus2.controls Titan Controls
pkg com.titanus2.cubecontact Cube Contact
pkg com.titanus2.nanobot Nanobot app
pkg com.tailscale.ipn Tailscale VPN
CAT
  fi
  chmod 666 "$DESIRE_EN" "$DESIRE_DENY" "$DESIRE_BINS" "$DESIRE_SVCS" "$PROTECT" "$CATALOG" 2>/dev/null || true
}

policy_is_protected() {
  tok=$1
  [ -n "$tok" ] || return 1
  policy_ensure
  # fixed-string line match (toybox-safe; no sed BRE)
  grep -qxF "$tok" "$PROTECT" 2>/dev/null && return 0
  # case-insensitive via tr
  low=$(echo "$tok" | tr '[:upper:]' '[:lower:]')
  tr '[:upper:]' '[:lower:]' <"$PROTECT" 2>/dev/null | grep -qxF "$low"
}

policy_bin_add() {
  policy_ensure
  b=$1
  grep -qxF "$b" "$DESIRE_BINS" 2>/dev/null || echo "$b" >>"$DESIRE_BINS"
  chmod 666 "$DESIRE_BINS" 2>/dev/null || true
}
policy_bin_del() {
  policy_ensure
  b=$1
  tmp=$ST/fw.bins.$$
  grep -vxF "$b" "$DESIRE_BINS" >"$tmp" 2>/dev/null || : >"$tmp"
  mv "$tmp" "$DESIRE_BINS" 2>/dev/null || true
  chmod 666 "$DESIRE_BINS" 2>/dev/null || true
}
policy_svc_add() {
  policy_ensure
  s=$1
  grep -qxF "$s" "$DESIRE_SVCS" 2>/dev/null || echo "$s" >>"$DESIRE_SVCS"
  chmod 666 "$DESIRE_SVCS" 2>/dev/null || true
}
policy_svc_del() {
  policy_ensure
  s=$1
  tmp=$ST/fw.svcs.$$
  grep -vxF "$s" "$DESIRE_SVCS" >"$tmp" 2>/dev/null || : >"$tmp"
  mv "$tmp" "$DESIRE_SVCS" 2>/dev/null || true
  chmod 666 "$DESIRE_SVCS" 2>/dev/null || true
}

# Resolve binary basename → owner uid.
# 1) static package map (works even when process not running)
# 2) live /proc comm|exe walk
# 3) catalog pkg line for same key
policy_resolve_bin_uid() {
  name=$1
  base=$(basename "$name" 2>/dev/null || echo "$name")
  # static product map — app-owned engines (demo-critical)
  case "$base" in
    nanobot|nanobot.real)
      policy_resolve_uid com.titanus2.nanobot && return 0
      ;;
    atlas|atlas-auth|atlas-sudo)
      policy_resolve_uid com.titanus2.atlas && return 0
      ;;
    titan2-fw|titan2-fw.sh|titan2-fw-observe)
      return 1
      ;;
  esac
  # catalog: "bin KEY label" may share key with "pkg com...." nearby — try pkg:KEY if dotted
  case "$base" in
    *.*)
      policy_resolve_uid "$base" 2>/dev/null && return 0
      ;;
  esac
  # walk /proc/*/comm and exe (bounded)
  n=0
  for p in /proc/[0-9]*; do
    n=$((n + 1))
    [ "$n" -gt 400 ] && break
    c=$(cat "$p/comm" 2>/dev/null) || continue
    case "$c" in
      "$base"|"$name") ;;
      *)
        e=$(readlink "$p/exe" 2>/dev/null || true)
        case "$e" in
          */"$base"|*/"$base".real|*/"$name") ;;
          *) continue ;;
        esac
        ;;
    esac
    uid=$(awk "/^Uid:/{print \$2; exit}" "$p/status" 2>/dev/null)
    [ -n "$uid" ] && echo "$uid" && return 0
  done
  return 1
}

# init.svc.NAME → running; map to uid via process name
policy_resolve_svc_uid() {
  svc=$1
  st=$(getprop "init.svc.$svc" 2>/dev/null)
  # try process matching service name / binary
  policy_resolve_bin_uid "$svc" && return 0
  # strip titan2- prefix variants
  base=${svc#titan2-}
  policy_resolve_bin_uid "$base" && return 0
  return 1
}

policy_enabled() {
  policy_ensure
  v=$(tr -d '\r\n \t' <"$DESIRE_EN" 2>/dev/null)
  case "$v" in on|1|true|yes) echo on ;; *) echo off ;; esac
}

policy_set_enabled() {
  policy_ensure
  case "$1" in
    on|off) _write "$DESIRE_EN" "$1" ;;
    *) _die "enabled must be on|off" ;;
  esac
}

# Normalize a deny token to a uid (numeric) or empty on failure.
# Accepts: bare uid, package name, "uid:NNNN", "pkg:name"
policy_resolve_uid() {
  tok=$1
  [ -n "$tok" ] || return 1
  case "$tok" in
    uid:*) tok=${tok#uid:} ;;
    pkg:*) tok=${tok#pkg:} ;;
  esac
  case "$tok" in
    ''|*[!0-9]*)
      # package → uid via pm (best-effort; may need non-isolated context)
      line=$(pm list packages -U "$tok" 2>/dev/null | head -1 | tr -d '\r')
      u=$(echo "$line" | sed -n 's/.*uid:\([0-9][0-9]*\).*/\1/p')
      [ -n "$u" ] || {
        # dumpsys package fallback
        u=$(dumpsys package "$tok" 2>/dev/null | sed -n 's/.*userId=\([0-9][0-9]*\).*/\1/p' | head -1)
      }
      [ -n "$u" ] && echo "$u" && return 0
      return 1
      ;;
    *)
      echo "$tok"
      return 0
      ;;
  esac
}

policy_deny_has() {
  uid=$1
  policy_ensure
  grep -qE "^${uid}([[:space:]]|$)" "$DESIRE_DENY" 2>/dev/null
}

policy_deny_add() {
  uid=$1
  note=${2:-}
  policy_ensure
  policy_deny_has "$uid" && return 0
  if [ -n "$note" ]; then
    echo "$uid  # $note" >>"$DESIRE_DENY"
  else
    echo "$uid" >>"$DESIRE_DENY"
  fi
  chmod 666 "$DESIRE_DENY" 2>/dev/null || true
}

policy_deny_del() {
  uid=$1
  policy_ensure
  [ -f "$DESIRE_DENY" ] || return 0
  tmp=$ST/titan2_fw.deny.tmp
  grep -vE "^${uid}([[:space:]]|$)" "$DESIRE_DENY" >"$tmp" 2>/dev/null || : >"$tmp"
  cat "$tmp" >"$DESIRE_DENY" 2>/dev/null || true
  rm -f "$tmp" 2>/dev/null || true
  chmod 666 "$DESIRE_DENY" 2>/dev/null || true
}

policy_deny_list_uids() {
  policy_ensure
  # strip comments / blank
  sed -n 's/#.*//; s/^[[:space:]]*//; s/[[:space:]]*$//; /^[0-9][0-9]*$/p' "$DESIRE_DENY" 2>/dev/null
}

policy_reset() {
  policy_ensure
  _write "$DESIRE_EN" "off"
  : >"$DESIRE_DENY" 2>/dev/null || true
  chmod 666 "$DESIRE_DENY" 2>/dev/null || true
}

# ─── fw-engine ───────────────────────────────────────────────────────────────

engine_have_ipt() {
  command -v iptables >/dev/null 2>&1 || _die "iptables missing"
  command -v ip6tables >/dev/null 2>&1 || true
}

# Create private chain + one jump from Android fw_OUTPUT (idempotent).
engine_ensure_hooks() {
  engine_have_ipt
  # IPv4
  iptables -N "$CHAIN" 2>/dev/null || true
  if ! iptables -C "$PARENT" -j "$CHAIN" 2>/dev/null; then
    # Prefer insert at head of fw_OUTPUT so we run before any future rules.
    iptables -I "$PARENT" 1 -j "$CHAIN" 2>/dev/null \
      || iptables -A "$PARENT" -j "$CHAIN" 2>/dev/null \
      || _die "cannot attach $CHAIN to $PARENT (IPv4)"
  fi
  # IPv6 (best-effort; same chain name in ip6tables namespace)
  if command -v ip6tables >/dev/null 2>&1; then
    ip6tables -N "$CHAIN" 2>/dev/null || true
    if ! ip6tables -C "$PARENT6" -j "$CHAIN" 2>/dev/null; then
      ip6tables -I "$PARENT6" 1 -j "$CHAIN" 2>/dev/null \
        || ip6tables -A "$PARENT6" -j "$CHAIN" 2>/dev/null || true
    fi
  fi
}

engine_flush() {
  engine_ensure_hooks
  iptables -F "$CHAIN" 2>/dev/null || true
  if command -v ip6tables >/dev/null 2>&1; then
    ip6tables -F "$CHAIN" 2>/dev/null || true
  fi
}

# Append one owner-uid REJECT to private chain (IPv4+IPv6).
# REJECT > DROP for snappier app errors; still netfilter under VPN.
engine_deny_uid_live() {
  uid=$1
  [ -n "$uid" ] || return 1
  engine_ensure_hooks
  # skip if already present
  if ! iptables -C "$CHAIN" -m owner --uid-owner "$uid" -j REJECT --reject-with icmp-port-unreachable 2>/dev/null; then
    iptables -A "$CHAIN" -m owner --uid-owner "$uid" -j REJECT --reject-with icmp-port-unreachable \
      || _die "owner match / REJECT failed for uid $uid (IPv4). Is xt_owner available?"
  fi
  if command -v ip6tables >/dev/null 2>&1; then
    if ! ip6tables -C "$CHAIN" -m owner --uid-owner "$uid" -j REJECT --reject-with icmp6-port-unreachable 2>/dev/null; then
      ip6tables -A "$CHAIN" -m owner --uid-owner "$uid" -j REJECT --reject-with icmp6-port-unreachable 2>/dev/null || true
    fi
  fi
}

# True if uid is shared system/shell — never owner-uid DROP (would brick radio/ss).
_is_system_uid() {
  case "$1" in 0|1000|1001|2000) return 0 ;; *) return 1 ;; esac
}

# Expand desire bins/svcs → non-system live UIDs (dedupe via policy_deny_add notes).
# System/shared UIDs stay desire-only (privacy-belt territory, not netfilter).
engine_expand_desire_entities() {
  policy_ensure
  while read -r b; do
    [ -z "$b" ] && continue
    case "$b" in \#*) continue ;; esac
    b=$(basename "$b" 2>/dev/null || echo "$b")
    u=$(policy_resolve_bin_uid "$b" 2>/dev/null) || u=
    if [ -z "$u" ]; then
      log "expand: bin $b — no uid (not mapped / not running)"
      continue
    fi
    if _is_system_uid "$u"; then
      log "expand: bin $b uid $u system — no netfilter (privacy-belt only)"
      continue
    fi
    policy_deny_add "$u" "bin:$b" 2>/dev/null || true
    log "expand: bin $b → uid $u live REJECT"
  done <"$DESIRE_BINS" 2>/dev/null || true
  while read -r s; do
    [ -z "$s" ] && continue
    case "$s" in \#*) continue ;; esac
    u=$(policy_resolve_svc_uid "$s" 2>/dev/null) || u=
    if [ -z "$u" ]; then
      log "expand: svc $s — no uid"
      continue
    fi
    if _is_system_uid "$u"; then
      log "expand: svc $s uid $u system — no netfilter"
      continue
    fi
    policy_deny_add "$u" "svc:$s" 2>/dev/null || true
    log "expand: svc $s → uid $u live REJECT"
  done <"$DESIRE_SVCS" 2>/dev/null || true
}

# Rebuild live rules from desire. Fail-open when disabled.
engine_apply() {
  _lock
  engine_ensure_hooks
  engine_flush
  en=$(policy_enabled)
  if [ "$en" != "on" ]; then
    log "apply: fail-open (enabled=off)"
    _write "$STATUS_FILE" "open enabled=off denies=0 ver=$VER"
    echo "applied: fail-open (enabled=off)"
    return 0
  fi
  # Product 0.3.1: bins/svcs must expand into live owner rules when non-system.
  engine_expand_desire_entities
  n=0
  for uid in $(policy_deny_list_uids); do
    if _is_system_uid "$uid"; then
      log "apply: skip system uid $uid (no owner DROP)"
      continue
    fi
    engine_deny_uid_live "$uid"
    n=$((n + 1))
  done
  log "apply: enabled=on denies=$n"
  _write "$STATUS_FILE" "enforcing enabled=on denies=$n ver=$VER"
  echo "applied: enforcing denies=$n"
}

engine_rules_print() {
  echo "# IPv4 $PARENT → $CHAIN"
  iptables -S "$PARENT" 2>/dev/null | grep -E "$CHAIN|fw_OUTPUT" || true
  echo "# IPv4 $CHAIN"
  iptables -S "$CHAIN" 2>/dev/null || echo "(missing)"
  if command -v ip6tables >/dev/null 2>&1; then
    echo "# IPv6 $CHAIN"
    ip6tables -S "$CHAIN" 2>/dev/null || echo "(missing)"
  fi
}

engine_teardown() {
  # Full reset of live hooks (still leave desire unless caller cleared it).
  engine_have_ipt
  iptables -F "$CHAIN" 2>/dev/null || true
  iptables -D "$PARENT" -j "$CHAIN" 2>/dev/null || true
  iptables -X "$CHAIN" 2>/dev/null || true
  if command -v ip6tables >/dev/null 2>&1; then
    ip6tables -F "$CHAIN" 2>/dev/null || true
    ip6tables -D "$PARENT6" -j "$CHAIN" 2>/dev/null || true
    ip6tables -X "$CHAIN" 2>/dev/null || true
  fi
}

# ─── fw-observe ──────────────────────────────────────────────────────────────

# Hex IPv4 "AABBCCDD:PPPP" → dotted + port (network byte order in /proc/net/tcp).
_obs_hex_ip4() {
  h=$1
  iphex=${h%:*}
  phex=${h#*:}
  # little-endian word on Android/Linux
  a=$((0x${iphex:6:2}))
  b=$((0x${iphex:4:2}))
  c=$((0x${iphex:2:2}))
  d=$((0x${iphex:0:2}))
  port=$((0x$phex))
  echo "$a.$b.$c.$d:$port"
}

# Fast path: /proc/net/tcp uid column only.
# Full /proc/*/fd inode walk hung on Titan lab — deferred to later observe pass.
observe_conns() {
  limit=${1:-80}
  echo "# proto local rem state uid inode  (uid = /proc/net column; deep map later)"

  n=0
  # Field layout (no awk on Titan toybox): sl laddr raddr st txrx trtm retrnsmt uid timeout inode …
  # shell `set --` mis-parses some rows; named read is reliable. Never name a var `local`.
  while read -r sl laddr raddr st txrx trtm retr uid_col timeout inode rest; do
    case "$laddr" in
      local_address|*:*) ;;
      *) continue ;;
    esac
    case "$laddr" in
      *:* ) ;;
      *) continue ;;
    esac
    lpretty=$(_obs_hex_ip4 "$laddr" 2>/dev/null || echo "$laddr")
    rpretty=$(_obs_hex_ip4 "$raddr" 2>/dev/null || echo "$raddr")
    echo "tcp $lpretty $rpretty st=$st uid=${uid_col:-?} ino=${inode:-?}"
    n=$((n + 1))
    [ "$n" -ge "$limit" ] && break
  done < /proc/net/tcp

  m=0
  if [ -r /proc/net/tcp6 ]; then
    while read -r sl laddr raddr st txrx trtm retr uid_col timeout inode rest; do
      case "$laddr" in *:* ) ;; *) continue ;; esac
      echo "tcp6 $laddr $raddr st=$st uid=${uid_col:-?} ino=${inode:-?}"
      m=$((m + 1))
      [ "$m" -ge "$limit" ] && break
    done < /proc/net/tcp6
  fi
  echo "# observe: $n tcp + $m tcp6 lines (limit=$limit)"
}

observe_vpn() {
  echo "# ifaces"
  ip -o link show 2>/dev/null | awk -F': ' '{print $2}' | while read -r ifc; do
    case "$ifc" in
      tun*|wg*|ppp*|tailscale*) echo "vpnish $ifc" ;;
    esac
  done
  ip -4 -o addr show 2>/dev/null | awk '/tun|wg|tailscale|ts-/ {print "addr", $0}'
  echo "# default routes"
  ip route 2>/dev/null | head -8
}

# ─── fw-ufw CLI ──────────────────────────────────────────────────────────────

cmd_status() {
  policy_ensure
  en=$(policy_enabled)
  denies=$(policy_deny_list_uids | wc -l | tr -d ' ')
  echo "titan2-fw $VER"
  echo "enabled=$en"
  echo "deny_count=$denies"
  echo "desire_en=$DESIRE_EN"
  echo "desire_deny=$DESIRE_DENY"
  echo "chain=$CHAIN parent=$PARENT"
  if [ "$(id -u 2>/dev/null)" = "0" ]; then
    live=$(iptables -S "$CHAIN" 2>/dev/null | grep -c 'uid-owner' || echo 0)
    echo "live_uid_rules=$live"
    # VPN note (orthogonal)
    vpn_if=$(ip -o link show 2>/dev/null | awk -F': ' '$2 ~ /^(tun|wg)[0-9]+/ {print $2; exit}')
    if [ -n "$vpn_if" ]; then
      echo "vpn_iface=$vpn_if (present — we do not own it)"
    else
      echo "vpn_iface=none"
    fi
    [ -f "$STATUS_FILE" ] && echo "status_file=$(cat "$STATUS_FILE" 2>/dev/null)"
  else
    echo "live_uid_rules=? (need root)"
  fi
  if [ "$denies" -gt 0 ]; then
    echo "# deny desire:"
    policy_deny_list_uids | while read -r u; do echo "  uid $u"; done
  fi
  bins=$(wc -l <"$DESIRE_BINS" 2>/dev/null | tr -d ' ')
  svcs=$(wc -l <"$DESIRE_SVCS" 2>/dev/null | tr -d ' ')
  echo "deny_bins=${bins:-0} file=$DESIRE_BINS"
  echo "deny_svcs=${svcs:-0} file=$DESIRE_SVCS"
  cbin=$(_find_observe_c 2>/dev/null) || cbin=missing
  echo "observe_c=$cbin"
  echo "live_ring=$LIVE_RING"
}

cmd_list() {
  policy_ensure
  echo "# desire deny (uid)"
  policy_deny_list_uids | while read -r u; do
    # try reverse package hint
    pkg=$(pm list packages -U 2>/dev/null | grep "uid:$u" | head -1 | sed 's/package://;s/ uid:.*//')
    if [ -n "$pkg" ]; then
      echo "$u  $pkg"
    else
      echo "$u"
    fi
  done
  if [ "$(id -u 2>/dev/null)" = "0" ]; then
    echo
    engine_rules_print
  fi
}

cmd_deny_uid() {
  tok=$1
  [ -n "$tok" ] || _die "usage: titan2-fw deny-uid <uid|package>"
  uid=$(policy_resolve_uid "$tok") || _die "cannot resolve uid for: $tok"
  # safety rails: never block root/system/shell/radio/media by accident without force
  case "$uid" in
    0|1000|1001|2000|1068)
      [ "$FORCE" = "1" ] || _die "refusing system uid $uid (FORCE=1 to override)"
      ;;
  esac
  policy_deny_add "$uid" "$tok"
  echo "desire: deny uid $uid ($tok)"
  if [ "$(policy_enabled)" = "on" ]; then
    if [ "$(id -u 2>/dev/null)" = "0" ]; then
      engine_apply
    else
      echo "note: enabled=on but not root — desire only; run as root: apply"
    fi
  else
    echo "note: enabled=off (fail-open). run: titan2-fw enable"
  fi
}

cmd_allow_uid() {
  tok=$1
  [ -n "$tok" ] || _die "usage: titan2-fw allow-uid <uid|package>"
  uid=$(policy_resolve_uid "$tok") || _die "cannot resolve uid for: $tok"
  policy_deny_del "$uid"
  echo "desire: allow (remove deny) uid $uid ($tok)"
  if [ "$(policy_enabled)" = "on" ] && [ "$(id -u 2>/dev/null)" = "0" ]; then
    engine_apply
  fi
}

cmd_enable() {
  policy_set_enabled on
  echo "desire: enabled=on"
  if [ "$(id -u 2>/dev/null)" = "0" ]; then
    engine_apply
  else
    echo "note: not root — desire only; run as root: apply"
  fi
}

cmd_disable() {
  policy_set_enabled off
  echo "desire: enabled=off (fail-open)"
  if [ "$(id -u 2>/dev/null)" = "0" ]; then
    engine_apply
  fi
}

cmd_reset() {
  policy_reset
  if [ "$(id -u 2>/dev/null)" = "0" ]; then
    engine_teardown
    # re-create empty hooks optional — teardown removes chain; next apply recreates
    _write "$STATUS_FILE" "reset ver=$VER"
  fi
  echo "reset: desire cleared, live chain torn down"
}

cmd_apply() {
  _need_root
  engine_apply
}

_find_observe_c() {
  for p in $OBSERVE_C_CANDIDATES; do
    [ -x "$p" ] && echo "$p" && return 0
  done
  return 1
}

# Write live ring for UI (append, rotate ~200 lines)
observe_live_write() {
  limit=${1:-80}
  cbin=$(_find_observe_c 2>/dev/null) || cbin=
  mkdir -p "$ST" 2>/dev/null || true
  if [ -n "$cbin" ]; then
    tmpf="${LIVE_RING}.tmp.$$"
    "$cbin" --json --limit "$limit" >"$tmpf" 2>/dev/null || true
    if [ -f "$tmpf" ]; then
      mv "$tmpf" "$LIVE_RING" 2>/dev/null || cat "$tmpf" >"$LIVE_RING"
      rm -f "$tmpf"
      chmod 666 "$LIVE_RING" 2>/dev/null || true
      cat "$LIVE_RING"
    else
      "$cbin" --json --limit "$limit"
    fi
  else
    observe_vpn
    echo
    observe_conns "$limit"
  fi
}

cmd_observe() {
  mode=${1:-}
  limit=80
  case "$mode" in
    live|json)
      shift 2>/dev/null || true
      limit=${1:-80}
      observe_live_write "$limit"
      return
      ;;
    ''|*[!0-9]*)
      :
      ;;
    *)
      limit=$mode
      ;;
  esac
  # Prefer C text for human; no hard root requirement for /proc/net read
  cbin=$(_find_observe_c 2>/dev/null) || cbin=
  if [ -n "$cbin" ]; then
    observe_vpn
    echo
    "$cbin" --text --limit "$limit"
  else
    observe_vpn
    echo
    observe_conns "$limit"
  fi
}

# Three-state honesty (Cube law — no fake denied=yes):
#   mode=none | desire | live | privacy-belt
# desire = listed but no netfilter; live = owner REJECT active; privacy-belt = system uid path.
cmd_entities() {
  policy_ensure
  echo "# catalog (services + binaries + key packages) — appear in Firewall settings"
  echo "# mode: none|desire|live|privacy-belt  (denied=yes only when mode=live)"
  while read -r kind key label; do
    case "$kind" in \#*|'') continue ;; esac
    mode=none
    denied=no
    u=
    case "$kind" in
      bin)
        if grep -qxF "$key" "$DESIRE_BINS" 2>/dev/null; then
          mode=desire
          u=$(policy_resolve_bin_uid "$key" 2>/dev/null) || u=
          if [ -n "$u" ]; then
            if _is_system_uid "$u"; then
              mode=privacy-belt
            elif policy_deny_has "$u" 2>/dev/null; then
              # live only if enabled+root rules exist — approximate via desire uid + enabled
              if [ "$(policy_enabled)" = "on" ]; then
                mode=live
                denied=yes
              else
                mode=desire
              fi
            fi
          fi
        fi
        ;;
      svc)
        if grep -qxF "$key" "$DESIRE_SVCS" 2>/dev/null; then
          mode=desire
          u=$(policy_resolve_svc_uid "$key" 2>/dev/null) || u=
          if [ -n "$u" ]; then
            if _is_system_uid "$u"; then
              mode=privacy-belt
            elif policy_deny_has "$u" 2>/dev/null; then
              if [ "$(policy_enabled)" = "on" ]; then
                mode=live
                denied=yes
              else
                mode=desire
              fi
            fi
          fi
        fi
        ;;
      pkg)
        # avoid dumpsys (binder) in hybrid shell — match package token in deny file comments/lines
        if grep -qF "$key" "$DESIRE_DENY" 2>/dev/null; then
          if [ "$(policy_enabled)" = "on" ]; then
            mode=live
            denied=yes
          else
            mode=desire
          fi
        fi
        ;;
    esac
    prot=no
    policy_is_protected "$key" && prot=yes
    echo "$kind  $key  denied=$denied  mode=$mode  uid=${u:--}  protect=$prot  # $label"
  done < "$CATALOG"
  echo "# deny.bins (annotated):"
  while read -r b; do
    [ -z "$b" ] && continue
    case "$b" in \#*) continue ;; esac
    u=$(policy_resolve_bin_uid "$b" 2>/dev/null) || u=
    if [ -z "$u" ]; then
      echo "  $b  mode=desire  uid=-  # not live / pending"
    elif _is_system_uid "$u"; then
      echo "  $b  mode=privacy-belt  uid=$u  # no netfilter DROP — use sensor-privacy belt"
    elif policy_deny_has "$u" && [ "$(policy_enabled)" = "on" ]; then
      echo "  $b  mode=live  uid=$u  # owner REJECT"
    else
      echo "  $b  mode=desire  uid=$u"
    fi
  done <"$DESIRE_BINS" 2>/dev/null || true
  echo "# deny.svcs (annotated):"
  while read -r s; do
    [ -z "$s" ] && continue
    case "$s" in \#*) continue ;; esac
    u=$(policy_resolve_svc_uid "$s" 2>/dev/null) || u=
    if [ -z "$u" ]; then
      echo "  $s  mode=desire  uid=-  # not live / pending"
    elif _is_system_uid "$u"; then
      echo "  $s  mode=privacy-belt  uid=$u  # no netfilter DROP — use sensor-privacy belt"
    elif policy_deny_has "$u" && [ "$(policy_enabled)" = "on" ]; then
      echo "  $s  mode=live  uid=$u  # owner REJECT"
    else
      echo "  $s  mode=desire  uid=$u"
    fi
  done <"$DESIRE_SVCS" 2>/dev/null || true
}

cmd_deny_bin() {
  b=$1
  [ -n "$b" ] || _die "usage: titan2-fw deny-bin <basename|path>"
  b=$(basename "$b")
  if policy_is_protected "$b"; then
    [ "$FORCE" = "1" ] || _die "protected bin $b (FORCE=1 to override) — nanobot/atlas/adbd stay open by default"
  fi
  policy_bin_add "$b"
  # best-effort: also deny owner uid if process live
  u=$(policy_resolve_bin_uid "$b" 2>/dev/null) || u=
  if [ -n "$u" ]; then
    case "$u" in 0|1000|1001|2000) echo "note: bin uid $u is system — desire bin only, no uid DROP" ;;
      *) policy_deny_add "$u" "bin:$b" 2>/dev/null || true
         echo "also desire deny uid $u for live $b"
         ;;
    esac
  fi
  echo "desire: deny-bin $b"
  if [ "$(policy_enabled)" = "on" ] && [ "$(id -u 2>/dev/null)" = "0" ]; then
    engine_apply
  fi
}

cmd_allow_bin() {
  b=$1
  [ -n "$b" ] || _die "usage: titan2-fw allow-bin <basename>"
  b=$(basename "$b")
  policy_bin_del "$b"
  u=$(policy_resolve_bin_uid "$b" 2>/dev/null) || u=
  [ -n "$u" ] && policy_deny_del "$u" 2>/dev/null || true
  echo "desire: allow-bin $b"
  if [ "$(policy_enabled)" = "on" ] && [ "$(id -u 2>/dev/null)" = "0" ]; then
    engine_apply
  fi
}

cmd_deny_svc() {
  s=$1
  [ -n "$s" ] || _die "usage: titan2-fw deny-svc <init.svc name>"
  if policy_is_protected "$s"; then
    [ "$FORCE" = "1" ] || _die "protected svc $s (FORCE=1 to override)"
  fi
  policy_svc_add "$s"
  u=$(policy_resolve_svc_uid "$s" 2>/dev/null) || u=
  if [ -n "$u" ]; then
    case "$u" in 0|1000|1001|2000) echo "note: svc uid $u system — desire only" ;;
      *) policy_deny_add "$u" "svc:$s" 2>/dev/null || true ;;
    esac
  fi
  echo "desire: deny-svc $s (uid=${u:-unknown})"
  if [ "$(policy_enabled)" = "on" ] && [ "$(id -u 2>/dev/null)" = "0" ]; then
    engine_apply
  fi
}

cmd_allow_svc() {
  s=$1
  [ -n "$s" ] || _die "usage: titan2-fw allow-svc <name>"
  policy_svc_del "$s"
  echo "desire: allow-svc $s"
  if [ "$(policy_enabled)" = "on" ] && [ "$(id -u 2>/dev/null)" = "0" ]; then
    engine_apply
  fi
}

cmd_version() {
  echo "titan2-fw $VER"
}

cmd_help() {
  cat <<EOF
titan2-fw $VER — under-VPN firewall (netfilter owner-uid; NO VpnService)

Usage:
  titan2-fw status
  titan2-fw list
  titan2-fw entities              # bins + services + key pkgs (nanobot…)
  titan2-fw deny-uid <uid|package>
  titan2-fw allow-uid <uid|package>
  titan2-fw deny-bin <name> | allow-bin <name>
  titan2-fw deny-svc <name> | allow-svc <name>
  titan2-fw enable | disable
  titan2-fw apply
  titan2-fw reset
  titan2-fw observe [limit]
  titan2-fw observe live [limit] # NDJSON ring for UI (C cube)
  titan2-fw version

Desire (SoT):
  $DESIRE_EN      on|off   (default off = fail-open)
  $DESIRE_DENY    one uid per line
  $DESIRE_BINS    binary basenames to deny
  $DESIRE_SVCS    init service names to deny
  $PROTECT        never auto-block (nanobot, atlas, adbd…)
  $CATALOG        entities shown in Firewall settings

Live observe (C):
  titan2-fw-observe --json|--text [--limit N] [--follow]
  ring: $LIVE_RING

Engine:
  iptables chain $CHAIN ← $PARENT ; -m owner --uid-owner UID -j REJECT
  under any VPN; NO VpnService
EOF
}

# ─── main ────────────────────────────────────────────────────────────────────

cmd=${1:-status}
shift 2>/dev/null || true

case "$cmd" in
  status)   cmd_status ;;
  list)     cmd_list ;;
  deny-uid|deny)  cmd_deny_uid "$1" ;;
  allow-uid|allow) cmd_allow_uid "$1" ;;
  deny-bin) cmd_deny_bin "$1" ;;
  allow-bin) cmd_allow_bin "$1" ;;
  deny-svc) cmd_deny_svc "$1" ;;
  allow-svc) cmd_allow_svc "$1" ;;
  entities|catalog) cmd_entities ;;
  enable|on)   cmd_enable ;;
  disable|off) cmd_disable ;;
  apply)    cmd_apply ;;
  reset)    cmd_reset ;;
  observe|conns) cmd_observe "$@" ;;
  version|-V|--version) cmd_version ;;
  help|-h|--help) cmd_help ;;
  *)
    echo "unknown: $cmd" >&2
    cmd_help >&2
    exit 2
    ;;
esac
