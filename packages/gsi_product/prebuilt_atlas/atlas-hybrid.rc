# Atlas hybrid ROM — prepare Debian plane after data is available (mount/bootstrap).
# NOT Deb session autostart. Product: system root prepare so app open works rootless
# on Android plane; Deb enter still uses hybrid when plane is up.
# SoT: packages/titan_atlas/scripts/atlas-hybrid.sh · atlas-hybrid-boot.sh

# Direct exec like titan2-pad-agent. Do NOT use /system/bin/sh SCRIPT —
# init refuses shell_exec (no domain transition from u:r:init:s0). 1217Z:
# rc parsed, start failed, Deb never came up. Scripts must be phhsu_exec.
service atlas-hybrid-boot /system/bin/atlas-hybrid-boot.sh
    class late_start
    user root
    group root system
    oneshot
    disabled

# Keep atlas-enterd up even when atlas-enterd.rc is missing from the image.
service atlas-hybrid-watch /system/bin/atlas-hybrid-watch.sh
    class late_start
    user root
    group root system
    disabled

on property:sys.boot_completed=1
    start atlas-hybrid-boot
    start atlas-hybrid-watch

# App / tip / delayed boot re-request ensure without full reboot
on property:sys.atlas.hybrid=1
    start atlas-hybrid-boot
    start atlas-hybrid-watch
    setprop sys.atlas.hybrid 0

# After first unlock some GSIs expose mapper late — second kick when user_0 appears
on property:sys.user.0.ce_available=1
    start atlas-hybrid-boot
    start atlas-hybrid-watch
