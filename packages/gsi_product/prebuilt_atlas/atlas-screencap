#!/system/bin/sh
# Alias only — same wrap as `screencap` / `android screencap`. No auth bypass.
set -f
WRAP=""
for w in /usr/local/libexec/atlas-android /system/bin/atlas-android \
  /data/data/com.titanus2.atlas/files/bin/atlas-android; do
  [ -x "$w" ] && WRAP=$w && break
done
[ -n "$WRAP" ] || { echo "atlas-screencap: atlas-android missing" >&2; exit 127; }
exec "$WRAP" screencap "$@"
