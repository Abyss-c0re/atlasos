<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.titanus2.overlay.sensorprivacy"
    android:versionCode="1"
    android:versionName="1.0-cube-privacy-cam-mic">
    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="35"/>
    <!--
      Cube PRIVACY_POLICY §2.2 — OS-level sensor kill switches.
      MediaTek FrameworkResOverlay forces config_supportsCamToggle=false →
      SystemUI RemovedTiles=[P(cameratoggle)]. This static product RRO wins
      over vendor (priority 2000 > typical vendor) and re-enables software
      camera + mic privacy toggles for stock QS + SensorPrivacyService.
    -->
    <overlay
        android:targetPackage="android"
        android:priority="2000"
        android:isStatic="true"/>
    <application
        android:hasCode="false"
        android:label="Titan Cube sensor privacy"/>
</manifest>
