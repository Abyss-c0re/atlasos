<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.titanus2.overlay.imenavbar"
    android:versionCode="2"
    android:versionName="1.1-no-empty-inset">
    <uses-sdk android:minSdkVersion="34" android:targetSdkVersion="36"/>
    <!--
      This panel is sw914dp. The gestural overlay turns
      config_imeDrawsImeNavBar on, and the taskbar reports
      taskbar_frame_height (56dp, 88px at 252dpi) as the nav inset.
      Hiding the buttons leaves that empty strip. This overlay turns
      the draw bool off, hides the nav bar while the keyboard is up,
      and sets the taskbar frame height to 0dp so the strip is gone.
      com.titanus2 sorts after com.android.internal, so a tie applies
      last. Mutable so Hide IME can disable it and Show brings the
      inset back. Hardware Back is key 158.
    -->
    <overlay
        android:targetPackage="android"
        android:priority="2147483647"/>
    <application
        android:hasCode="false"
        android:label="Titan IME nav bar"/>
</manifest>
