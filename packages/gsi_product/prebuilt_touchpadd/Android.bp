// Prebuilt touchpadd for MisterZtr systemimage (OPTIMIZE Phase 1.5).
// AtlasOS: stage into the tree, then m systemimage. Not hybrid inject.
// Confirmed Mouse Mode: INPROC_PARK + pad-only + titan2-virtual-mouse.
// SoT binary: third_party/titan2-touchpadd/bin/titan2-touchpadd
// IDC: PRODUCT_COPY_FILES in titanus2.mk → /system/usr/idc
// Stage: ./scripts/misterztr/stage_gsi_product.sh → vendor/titanus2/prebuilts/…

cc_prebuilt_binary {
    name: "titan2-touchpadd",
    srcs: ["titan2-touchpadd"],
    compile_multilib: "64",
    check_elf_files: false,
    system_shared_libs: [],
    stem: "titan2-touchpadd",
}

// Disabled late_start oneshot — pad-agent / plane owns start in mouse mode.
// Binary still lands at /system/bin for tip-free product path.
prebuilt_etc {
    name: "titan2-touchpadd.rc",
    src: "titan2-touchpadd.rc",
    sub_dir: "init",
    filename_from_src: true,
}
