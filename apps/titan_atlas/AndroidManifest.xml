<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.titanus2.atlas"
    android:versionCode="159"
    android:versionName="1.0.31-root">

    <uses-sdk android:minSdkVersion="28" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />
    <uses-permission android:name="android.permission.USE_FINGERPRINT" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".AtlasApp"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Atlas"
        android:extractNativeLibs="true"
        android:usesCleartextTraffic="true"
        android:allowBackup="false"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:resizeableActivity="true">

        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="stateHidden|adjustResize"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|smallestScreenSize|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:label="Atlas settings"
            android:theme="@style/Theme.Atlas.Settings"
            android:exported="true"
            android:parentActivityName=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".UsersActivity"
            android:label="Users"
            android:theme="@style/Theme.Atlas.Settings"
            android:exported="false"
            android:parentActivityName=".SettingsActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".BackupsActivity"
            android:label="Backups"
            android:theme="@style/Theme.Atlas.Settings"
            android:exported="false"
            android:parentActivityName=".SettingsActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".AuthLogActivity"
            android:label="Request log"
            android:theme="@style/Theme.Atlas.Settings"
            android:exported="false"
            android:parentActivityName=".SettingsActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".AuthAccessActivity"
            android:label="Access"
            android:theme="@style/Theme.Atlas.Settings"
            android:exported="false"
            android:parentActivityName=".SettingsActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".AuthBinsActivity"
            android:label="Managed binaries"
            android:theme="@style/Theme.Atlas.Settings"
            android:exported="false"
            android:parentActivityName=".SettingsActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize" />

        <!-- exported so su/atlas-auth can `am start` the biometric gate from a root shell.
             separate taskAffinity + singleInstance: must not steal/restart MainActivity PTY -->
        <activity
            android:name=".AuthPromptActivity"
            android:label="Atlas auth"
            android:exported="true"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="com.titanus2.atlas.auth"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize">
            <intent-filter>
                <action android:name="com.titanus2.atlas.action.AUTH_PROMPT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <service
            android:name=".AtlasSessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="atlas_auth_agent_and_sessions" />
        </service>

        <!-- OS Authentication Agent — boot without opening terminal -->
        <receiver
            android:name=".AtlasAuthAgentReceiver"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
            </intent-filter>
        </receiver>

        <!-- Remote auth: KDE Connect plugin bridge / BlackCube sudo / nanobot.
             Local atlas-auth file protocol for shell sudo is unchanged. -->
        <receiver
            android:name=".RemoteAuthReceiver"
            android:exported="true"
            android:enabled="true">
            <intent-filter>
                <action android:name="com.titanus2.atlas.action.REMOTE_AUTH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- KDE Connect share / Send to device text starting with ATLAS_AUTH: -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
