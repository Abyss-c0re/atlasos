# Atlas hybrid — prepare Debian plane + request watch.
# Enter daemon lives in atlas-enterd.rc (separate — must register).
# Direct-exec .sh only. No seclabel u:r:su:s0. No Magisk.

service atlas-hybrid-boot /system/bin/atlas-hybrid-boot.sh
    class late_start
    user root
    group root system
    oneshot
    disabled

service atlas-hybrid-watch /system/bin/atlas-hybrid-watch.sh
    class late_start
    user root
    group root system
    oneshot
    disabled

on property:sys.boot_completed=1
    start atlas-hybrid-boot
    start atlas-hybrid-watch

on property:sys.atlas.hybrid.ensure=1
    start atlas-hybrid-boot
    setprop sys.atlas.hybrid.ensure 0
