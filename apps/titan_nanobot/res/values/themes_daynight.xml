<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Follow system day/night (DeviceDefault). No mixed light chrome on dark OS. -->
    <style name="Theme.Nanobot.DayNight" parent="@android:style/Theme.DeviceDefault.DayNight">
        <item name="android:windowBackground">?android:attr/colorBackground</item>
        <item name="android:colorBackground">?android:attr/colorBackground</item>
        <item name="android:statusBarColor">?android:attr/colorBackground</item>
        <item name="android:navigationBarColor">?android:attr/colorBackground</item>
        <item name="android:windowLightStatusBar">true</item>
    </style>
    <style name="Theme.Nanobot.DayNight.NoActionBar" parent="@style/Theme.Nanobot.DayNight">
        <item name="android:windowActionBar">false</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
