     /** Flow of whether the subscription enabled for the given [subId]. */
+    private fun mergeInsertedSubscriptions(availableList: ArrayList<SubscriptionInfo>) {
+        try {
+            val have = availableList.map { it.subscriptionId }.toHashSet()
+            val insertedIcc = insertedIccIds()
+            val all = subscriptionManager.getAllSubscriptionInfoList() ?: return
+            for (info in all) {
+                if (info == null || have.contains(info.subscriptionId)) continue
+                if (info.isOpportunistic) continue
+                val icc = info.iccId
+                val inSlot = info.simSlotIndex != SubscriptionManager.INVALID_SIM_SLOT_INDEX
+                val cardIn = !icc.isNullOrEmpty() && insertedIcc.any { present ->
+                    present.startsWith(icc) || icc.startsWith(present) ||
+                        (present.length >= 8 && icc.startsWith(present.substring(0, 8)))
+                }
+                if (!inSlot && !cardIn) continue
+                availableList.add(info)
+                have.add(info.subscriptionId)
+            }
+        } catch (_: Throwable) {
+        }
+    }
+
+    private fun insertedIccIds(): List<String> {
+        val tm = context.getSystemService(TelephonyManager::class.java) ?: return emptyList()
+        val slots = tm.uiccSlotsInfo ?: return emptyList()
+        val out = ArrayList<String>()
+        for (slot in slots) {
+            if (slot == null) continue
+            if (slot.cardStateInfo != UiccSlotInfo.CARD_STATE_INFO_PRESENT) continue
+            try {
+                for (port in slot.ports) {
+                    val id = port.iccId ?: continue
+                    if (id.isNotEmpty()) out.add(id)
+                }
+            } catch (_: Throwable) {
+            }
+        }
+        return out
+    }
+
