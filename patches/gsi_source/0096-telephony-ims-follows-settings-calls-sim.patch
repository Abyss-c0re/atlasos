+    /**
+     * Settings → SIMs → Calls is the only IMS tray switch.
+     * persist.radio.titan2_simswitch is radio-owned SoT (1-indexed).
+     * Init titan2-ims-simswitch-early.sh resetprop's the vendor simswitch
+     * the phone process cannot write, then recreates the MMTEL binder.
+     */
+    private void alignImsCapabilityToVoiceSub(int subId) {
+        if (!SubscriptionManager.isValidSubscriptionId(subId)) {
+            return;
+        }
+        int slot = getSlotIndex(subId);
+        if (!SubscriptionManager.isValidSlotIndex(slot)) {
+            return;
+        }
+        String want = String.valueOf(slot + 1);
+        try {
+            // Radio-owned. Init watches this and applies vendor simswitch.
+            SystemProperties.set("persist.radio.titan2_simswitch", want);
+            SystemProperties.set("persist.radio.simswitch", want);
+            // Best-effort; vendor_radio_prop usually ignores phone setprop.
+            SystemProperties.set("persist.vendor.radio.simswitch", want);
+            SystemProperties.set("persist.vendor.radio.c_capability_slot", want);
+            log("alignImsCapabilityToVoiceSub: calls subId=" + subId
+                    + " slot=" + slot + " simswitch=" + want);
+        } catch (RuntimeException e) {
+            loge("alignImsCapabilityToVoiceSub failed: " + e);
+        }
+        // Recreate MMTEL on the Calls tray after SoT is written. Vendor
+        // simswitch may still be racing init resetprop; ImsService rebind
+        // after boot is handled by titan2-ims-simswitch-early.sh.
+        try {
+            ImsResolver resolver = ImsResolver.getInstance();
+            if (resolver != null) {
+                resolver.resetIms(slot);
+            }
+        } catch (RuntimeException e) {
+            loge("alignImsCapabilityToVoiceSub resetIms: " + e);
+        }
+    }
