+    // Titan 2: MTK getCameraIdList returns only 0+1. HI847S (2) and SAT (3)
+    // exist as virtual devices (torch status "unknown device@1.1/internal/2")
+    // but are hidden. include_all_cameras probes them so CameraService ADDs.
+    // addDevice fails closed if HAL refuses the interface.
+    if (property_get_bool("persist.sys.phh.include_all_cameras", false)) {
+        std::string prefix = "device@1.1/internal/";
+        if (!devices.empty()) {
+            auto slash = devices[0].rfind('/');
+            if (slash != std::string::npos) {
+                prefix = devices[0].substr(0, slash + 1);
+            }
+        }
+        for (const char *extra : {"2", "3"}) {
+            bool have = false;
+            for (const auto &id : mProviderPublicCameraIds) {
+                if (id == extra) {
+                    have = true;
+                    break;
+                }
+            }
+            if (have) continue;
+            std::string name = prefix + extra;
+            uint16_t major, minor;
+            std::string type, id;
+            if (parseDeviceName(name, &major, &minor, &type, &id) != OK) {
+                continue;
+            }
+            ALOGI("TitanCam: probing HAL-hidden camera %s", name.c_str());
+            devices.push_back(name);
+            mProviderPublicCameraIds.push_back(id);
+        }
+    }
+
     // Get list of concurrent streaming camera device combinations
     res = getConcurrentCameraIdsInternalLocked(interface);
     if (res != OK) {
