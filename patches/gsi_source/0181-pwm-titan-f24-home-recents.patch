+    /**
+     * Titan 2 printed Recents/Home key (Linux 580 / KEY_APPSELECT).
+     * Keylayout maps it to F24 so AOSP APP_SWITCH hold-preview never runs.
+     * Short = Home. Long = overview ({@code showRecentApps}, not 187).
+     */
+    private final class TitanNavKeyRule extends SingleKeyGestureDetector.SingleKeyRule {
+        TitanNavKeyRule() {
+            super(KeyEvent.KEYCODE_F24);
+        }
+
+        @Override
+        boolean supportLongPress() {
+            return true;
+        }
+
+        @Override
+        int getMaxMultiPressCount() {
+            return 1;
+        }
+
+        @Override
+        void onKeyGesture(@NonNull SingleKeyGestureEvent event) {
+            if (event.getAction() != ACTION_COMPLETE) {
+                return;
+            }
+            switch (event.getType()) {
+                case SINGLE_KEY_GESTURE_TYPE_PRESS:
+                    launchHomeFromHotKey(DEFAULT_DISPLAY);
+                    break;
+                case SINGLE_KEY_GESTURE_TYPE_LONG_PRESS:
+                    if (!keyguardOn()) {
+                        showRecentApps(false);
+                    }
+                    break;
+            }
+        }
+    }
+
     /**
      * Rule for single assist key gesture.
      */
@@ -3273,6 +3311,7 @@ public class PhoneWindowManager implements WindowManagerPolicy {
         mSingleKeyGestureDetector.addRule(new BackKeyRule());
         mSingleKeyGestureDetector.addRule(new StylusTailButtonRule());
         mSingleKeyGestureDetector.addRule(new AppSwitchKeyRule());
+        mSingleKeyGestureDetector.addRule(new TitanNavKeyRule());
         mSingleKeyGestureDetector.addRule(new AssistKeyRule());
     }
 
