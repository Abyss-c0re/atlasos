         mIsCallUsingMicrophone = mIsTrackingManagedAliveCall && !isMuted
                 && !isCarrierPrivilegedUsingMicDuringVoipCall();
         if (wasUsingMicrophone != mIsCallUsingMicrophone) {
@@ -3424,6 +3432,12 @@ public class InCallController extends CallsManagerListenerBase implements
                 mCallIdMapper.getCalls().stream().anyMatch(Call::getIsVoipAudioMode);
     }
 
+    private boolean isMicrophonePrivacyEnabled() {
+        return mSensorPrivacyManager != null
+                && mSensorPrivacyManager.areAnySensorPrivacyTogglesEnabled(
