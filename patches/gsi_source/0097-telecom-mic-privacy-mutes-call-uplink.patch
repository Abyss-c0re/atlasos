# project:packages/services/Telecomm
# PRIVACY §2: mic privacy ON must mute voice uplink. Unlock dialog is not a gate.
diff --git a/src/com/android/server/telecom/CallsManager.java b/src/com/android/server/telecom/CallsManager.java
index e5f9b0da9..b0708fe88 100644
--- a/src/com/android/server/telecom/CallsManager.java
+++ b/src/com/android/server/telecom/CallsManager.java
@@ -67,6 +67,7 @@ import android.content.pm.ResolveInfo;
 import android.content.pm.UserInfo;
 import android.graphics.Color;
 import android.graphics.drawable.ColorDrawable;
+import android.hardware.SensorPrivacyManager;
 import android.media.AudioManager;
 import android.media.AudioSystem;
 import android.media.MediaPlayer;
@@ -692,6 +693,17 @@ public class CallsManager extends Call.ListenerBase
 
         mContext = context;
         mLock = lock;
+        // PRIVACY §2: mic software toggle must mute voice uplink, not just
+        // show SensorPrivacy "unlock microphone" theater (startOp is tracing).
+        SensorPrivacyManager spm = context.getSystemService(SensorPrivacyManager.class);
+        if (spm != null) {
+            spm.addSensorPrivacyListener(SensorPrivacyManager.Sensors.MICROPHONE,
+                    (sensor, enabled) -> {
+                        if (enabled) {
+                            mute(true);
+                        }
+                    });
+        }
         mPhoneNumberUtilsAdapter = phoneNumberUtilsAdapter;
         mPhoneAccountRegistrar = phoneAccountRegistrar;
         mPhoneAccountRegistrar.addListener(mPhoneAccountListener);
@@ -4497,9 +4509,23 @@ public class CallsManager extends Call.ListenerBase
             Log.i(this, "Refusing to turn on mute because we're in an emergency call");
             shouldMute = false;
         }
+        // Human refused "unlock microphone" must stay silent. AOSP only
+        // shows the dialog (InCallController startOp is tracing).
+        if (!shouldMute && !isInEmergencyCall() && isMicrophonePrivacyEnabled()) {
+            Log.i(this, "Refusing unmute — microphone sensor privacy is ON");
+            shouldMute = true;
+        }
         mCallAudioManager.mute(shouldMute);
     }
 
+    private boolean isMicrophonePrivacyEnabled() {
+        SensorPrivacyManager spm = mContext.getSystemService(SensorPrivacyManager.class);
+        if (spm == null) {
+            return false;
+        }
+        return spm.areAnySensorPrivacyTogglesEnabled(SensorPrivacyManager.Sensors.MICROPHONE);
+    }
+
