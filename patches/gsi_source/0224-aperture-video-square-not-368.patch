+    private fun rowFits(
+        plane: android.media.Image.Plane,
+        x: Int,
+        y: Int,
+        rowBytes: Int,
+        rows: Int,
+    ): Boolean {
+        if (x < 0 || y < 0 || rowBytes <= 0 || rows <= 0) {
+            return false
+        }
+        val buf = plane.buffer
+        val base = buf.position()
+        val limit = buf.limit()
+        val rowEnd = x * plane.pixelStride + rowBytes
