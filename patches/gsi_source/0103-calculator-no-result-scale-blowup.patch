# project:packages/apps/ExactCalculator
# Titan two-line: do not scale/translate the result into the formula slot.
# 0101 only fitted formula text; onResult still blew short numbers (666) to
# formulaMax/resultSize and left the bottoms over the keypad after an operator.
diff --git a/res/layout/display_two_line.xml b/res/layout/display_two_line.xml
--- a/res/layout/display_two_line.xml
+++ b/res/layout/display_two_line.xml
@@ -1,4 +1,6 @@
         android:layout_width="match_parent"
         android:layout_height="0dp"
         android:layout_weight="1"
+        android:clipChildren="true"
+        android:clipToPadding="true"
         android:orientation="vertical">
diff --git a/res/values/dimens.xml b/res/values/dimens.xml
--- a/res/values/dimens.xml
+++ b/res/values/dimens.xml
@@ -18,16 +18,16 @@
     <dimen name="formula_padding_bottom">8dip</dimen>
     <dimen name="formula_padding_start">16dip</dimen>
     <dimen name="formula_padding_end">16dip</dimen>
-    <dimen name="formula_min_textsize">20dip</dimen>
-    <dimen name="formula_max_textsize">36dip</dimen>
-    <dimen name="formula_step_textsize">4dip</dimen>
+    <dimen name="formula_min_textsize">16dip</dimen>
+    <dimen name="formula_max_textsize">24dip</dimen>
+    <dimen name="formula_step_textsize">2dip</dimen>
 
     <!-- Dimens for display result. -->
     <dimen name="result_padding_top">4dip</dimen>
     <dimen name="result_padding_bottom">12dip</dimen>
     <dimen name="result_padding_start">16dip</dimen>
     <dimen name="result_padding_end">16dip</dimen>
-    <dimen name="result_textsize">22dip</dimen>
+    <dimen name="result_textsize">20dip</dimen>
