+    /**
+     * Software mic privacy = unplug capture. Never touch DEVICE_OUT_*
+     * (playback shares Hostless_Spk / FS19XX capture PCM on this MTK —
+     * chmod pcm*c silences the speaker).
+     */
+    private void applyMicPrivacyInputDisconnect(boolean privacyOn) {
+        final int state = privacyOn
+                ? AudioSystem.DEVICE_STATE_UNAVAILABLE
+                : AudioSystem.DEVICE_STATE_AVAILABLE;
+        // Input-only. Not SCO (bidirectional call). Not TELEPHONY_RX (downlink).
+        final int[] inputs = new int[] {
+                AudioSystem.DEVICE_IN_BUILTIN_MIC,
+                AudioSystem.DEVICE_IN_BACK_MIC,
+                AudioSystem.DEVICE_IN_WIRED_HEADSET,
+                AudioSystem.DEVICE_IN_USB_HEADSET,
+                AudioSystem.DEVICE_IN_USB_DEVICE,
+                AudioSystem.DEVICE_IN_HDMI,
+                AudioSystem.DEVICE_IN_BLUETOOTH_BLE,
+        };
+        for (int type : inputs) {
+            try {
+                int res = mAudioSystem.setDeviceConnectionState(
+                        new AudioDeviceAttributes(type, ""),
+                        state, 0 /* codecFormat */, false /* deviceSwitch */);
+                if (res != AudioSystem.AUDIO_STATUS_OK) {
+                    Log.w(TAG, "mic privacy input type=0x" + Integer.toHexString(type)
+                            + " state=" + state + " res=" + res);
+                }
+            } catch (RuntimeException e) {
+                Log.w(TAG, "mic privacy input type=0x" + Integer.toHexString(type), e);
+            }
+        }
+        Log.i(TAG, "mic privacy input disconnect=" + privacyOn);
+    }
