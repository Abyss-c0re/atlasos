diff --git a/app/src/main/java/org/lineageos/aperture/utils/TitanAspect.kt b/app/src/main/java/org/lineageos/aperture/utils/TitanAspect.kt
new file mode 100644
index 0000000..c1a50cd
--- /dev/null
+++ b/app/src/main/java/org/lineageos/aperture/utils/TitanAspect.kt
@@ -0,0 +1,95 @@
+/*
+ * SPDX-FileCopyrightText: AtlasOS / Titan 2
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.aperture.utils
+
+import android.content.ContentResolver
+import android.graphics.Bitmap
+import android.graphics.BitmapFactory
+import android.net.Uri
+import androidx.camera.core.AspectRatio
+import androidx.camera.core.resolutionselector.AspectRatioStrategy
+import androidx.camera.core.resolutionselector.ResolutionSelector
+import kotlin.math.min
+
+/**
+ * CameraX AspectRatio is 4:3 / 16:9 only. Titan 2 HAL still advertises
+ * native square JPEGs (main: 3504² / 3000² / 1440²). Prefer those; if
+ * CameraX still delivers 4:3, center-crop the saved file.
+ */
+object TitanAspect {
+    const val RATIO_1_1 = 11
+
+    fun isSquare(ratio: Int) = ratio == RATIO_1_1
+
+    fun captureRatio(ratio: Int): Int =
+        if (isSquare(ratio)) AspectRatio.RATIO_4_3 else ratio
+
+    /** Preview stream: prefer a native square (1440² on Titan) so FILL_CENTER is 1:1. */
+    fun previewResolutionSelector(ratio: Int): ResolutionSelector {
+        val builder = ResolutionSelector.Builder()
+            .setAllowedResolutionMode(
+                ResolutionSelector.PREFER_CAPTURE_RATE_OVER_HIGHER_RESOLUTION
+            )
+            .setAspectRatioStrategy(
+                AspectRatioStrategy(
+                    captureRatio(ratio),
+                    AspectRatioStrategy.FALLBACK_RULE_AUTO,
+                )
+            )
+        if (isSquare(ratio)) {
+            builder.setResolutionFilter { supportedSizes, _ ->
+                val squares = supportedSizes.filter { it.width == it.height }
+                    .sortedByDescending { it.width.toLong() * it.height }
+                (if (squares.isNotEmpty()) squares else supportedSizes).toMutableList()
+            }
+        }
+        return builder.build()
+    }
+
+    fun photoResolutionSelector(ratio: Int, highResolution: Boolean): ResolutionSelector {
+        val builder = ResolutionSelector.Builder()
+            .setAllowedResolutionMode(
+                if (highResolution) {
+                    ResolutionSelector.PREFER_HIGHER_RESOLUTION_OVER_CAPTURE_RATE
+                } else {
+                    ResolutionSelector.PREFER_CAPTURE_RATE_OVER_HIGHER_RESOLUTION
+                }
+            )
+            .setAspectRatioStrategy(
+                AspectRatioStrategy(
+                    captureRatio(ratio),
+                    AspectRatioStrategy.FALLBACK_RULE_AUTO,
+                )
+            )
+        if (isSquare(ratio)) {
+            builder.setResolutionFilter { supportedSizes, _ ->
+                val squares = supportedSizes.filter { it.width == it.height }
+                (if (squares.isNotEmpty()) squares else supportedSizes)
+                    .sortedByDescending { it.width.toLong() * it.height }
+                    .toMutableList()
+            }
+        }
+        return builder.build()
+    }
+
+    fun cropSavedJpegToSquare(resolver: ContentResolver, uri: Uri) {
+        val input = resolver.openInputStream(uri) ?: return
+        val src = input.use { BitmapFactory.decodeStream(it) } ?: return
+        val side = min(src.width, src.height)
+        if (side <= 0 || (src.width == side && src.height == side)) {
+            src.recycle()
+            return
+        }
+        val x = (src.width - side) / 2
+        val y = (src.height - side) / 2
+        val sq = Bitmap.createBitmap(src, x, y, side, side)
+        src.recycle()
+        resolver.openOutputStream(uri, "wt")?.use { out ->
+            sq.compress(Bitmap.CompressFormat.JPEG, 95, out)
+        }
+        sq.recycle()
+    }
+}
diff --git a/app/src/main/java/org/lineageos/aperture/utils/TitanVideo.kt b/app/src/main/java/org/lineageos/aperture/utils/TitanVideo.kt
new file mode 100644
index 0000000..5ff1960
--- /dev/null
+++ b/app/src/main/java/org/lineageos/aperture/utils/TitanVideo.kt
@@ -0,0 +1,361 @@
+/*
+ * SPDX-FileCopyrightText: AtlasOS / Titan 2
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.aperture.utils
+
+import android.content.ContentResolver
+import android.content.ContentValues
+import android.media.MediaCodec
+import android.media.MediaCodecInfo
+import android.media.MediaExtractor
+import android.media.MediaFormat
+import android.media.MediaMetadataRetriever
+import android.media.MediaMuxer
+import android.net.Uri
+import android.provider.MediaStore
+import android.util.Log
+import android.util.Range
+import android.util.Size
+import androidx.camera.video.Quality
+import androidx.camera.video.QualitySelector
+import androidx.camera.view.CameraController
+import org.lineageos.aperture.models.FrameRate
+import java.io.File
+import java.nio.ByteBuffer
+import kotlin.math.min
+
+/**
+ * OEM ACamera2 + vendor media_profiles_V1_0.xml (back IMX766):
+ *   3840×2160 @ 30, 1920×1080 @ 30/60, 1280×720 @ 30/60, 640×480 @ 30.
+ * Square 720² / 1080² / 1440² are Agui CamcorderProfile 5000–5002 — not
+ * in GSI media_profiles, so CameraX Quality cannot encode them. 1:1 files
+ * are a center-crop of the matching 16:9 HAL encode (FHD→1080²).
+ *
+ * 368×1080 is not a HAL size. Square preview filter + FHD QualitySelector
+ * produced it. Video preview stays 16:9; finder is FILL_CENTER.
+ */
+object TitanVideo {
+    private const val TAG = "TitanVideo"
+    private const val TIMEOUT_US = 10_000L
+
+    fun oemSize(quality: Quality): Size = when (quality) {
+        Quality.UHD -> Size(3840, 2160)
+        Quality.FHD -> Size(1920, 1080)
+        Quality.HD -> Size(1280, 720)
+        Quality.SD -> Size(640, 480)
+        else -> Size(1920, 1080)
+    }
+
+    fun oemFrameRate(quality: Quality, requested: FrameRate?): FrameRate {
+        val want = requested ?: if (quality == Quality.UHD) FrameRate.FPS_30 else FrameRate.FPS_60
+        return if (quality == Quality.UHD && want.value > 30) FrameRate.FPS_30 else want
+    }
+
+    fun applyToController(
+        controller: CameraController,
+        quality: Quality,
+        frameRate: FrameRate?,
+    ) {
+        val fps = oemFrameRate(quality, frameRate)
+        controller.videoCaptureQualitySelector = QualitySelector.from(quality)
+        controller.videoCaptureTargetFrameRate = Range(fps.value, fps.value)
+    }
+
+    fun cropSavedVideoToSquare(resolver: ContentResolver, uri: Uri) {
+        val retriever = MediaMetadataRetriever()
+        val width: Int
+        val height: Int
+        try {
+            retriever.setDataSource(resolver.openFileDescriptor(uri, "r")?.fileDescriptor)
+            width = retriever.extractMetadata(
+                MediaMetadataRetriever.METADATA_KEY_VIDEO_WIDTH
+            )?.toIntOrNull() ?: 0
+            height = retriever.extractMetadata(
+                MediaMetadataRetriever.METADATA_KEY_VIDEO_HEIGHT
+            )?.toIntOrNull() ?: 0
+        } catch (t: Throwable) {
+            Log.w(TAG, "retriever open failed", t)
+            return
+        } finally {
+            retriever.release()
+        }
+        val side = min(width, height)
+        if (side <= 0 || width == height) {
+            return
+        }
+        val cache = File.createTempFile("titan-sq-", ".mp4")
+        try {
+            resolver.openFileDescriptor(uri, "r")?.use { pfd ->
+                transcodeSquare(pfd.fileDescriptor, cache, width, height, side)
+            } ?: return
+            resolver.openOutputStream(uri, "wt")?.use { out ->
+                cache.inputStream().use { it.copyTo(out) }
+            } ?: return
+            val values = ContentValues().apply {
+                put(MediaStore.Video.Media.WIDTH, side)
+                put(MediaStore.Video.Media.HEIGHT, side)
+                put(MediaStore.MediaColumns.WIDTH, side)
+                put(MediaStore.MediaColumns.HEIGHT, side)
+            }
+            runCatching { resolver.update(uri, values, null, null) }
+            Log.i(TAG, "cropped $width x $height -> ${side}x$side")
+        } catch (t: Throwable) {
+            Log.w(TAG, "square crop failed, keeping ${width}x$height", t)
+        } finally {
+            cache.delete()
+        }
+    }
+
+    private fun transcodeSquare(
+        fd: java.io.FileDescriptor,
+        outFile: File,
+        width: Int,
+        height: Int,
+        side: Int,
+    ) {
+        val extractor = MediaExtractor()
+        extractor.setDataSource(fd)
+        var videoTrack = -1
+        var audioTrack = -1
+        var videoFormat: MediaFormat? = null
+        var audioFormat: MediaFormat? = null
+        for (i in 0 until extractor.trackCount) {
+            val format = extractor.getTrackFormat(i)
+            val mime = format.getString(MediaFormat.KEY_MIME).orEmpty()
+            when {
+                mime.startsWith("video/") && videoTrack < 0 -> {
+                    videoTrack = i
+                    videoFormat = format
+                }
+                mime.startsWith("audio/") && audioTrack < 0 -> {
+                    audioTrack = i
+                    audioFormat = format
+                }
+            }
+        }
+        val inFmt = videoFormat ?: error("no video track")
+        val mime = inFmt.getString(MediaFormat.KEY_MIME) ?: MediaFormat.MIMETYPE_VIDEO_AVC
+        val fps = if (inFmt.containsKey(MediaFormat.KEY_FRAME_RATE)) {
+            inFmt.getInteger(MediaFormat.KEY_FRAME_RATE).coerceAtLeast(24)
+        } else {
+            30
+        }
+        val rotation = if (inFmt.containsKey(MediaFormat.KEY_ROTATION)) {
+            inFmt.getInteger(MediaFormat.KEY_ROTATION)
+        } else {
+            0
+        }
+
+        val decoder = MediaCodec.createDecoderByType(mime)
+        decoder.configure(inFmt, null, null, 0)
+        decoder.start()
+
+        val encFmt = MediaFormat.createVideoFormat(MediaFormat.MIMETYPE_VIDEO_AVC, side, side)
+        encFmt.setInteger(
+            MediaFormat.KEY_COLOR_FORMAT,
+            MediaCodecInfo.CodecCapabilities.COLOR_FormatYUV420Flexible,
+        )
+        encFmt.setInteger(MediaFormat.KEY_BIT_RATE, (side * side * 6).coerceAtLeast(4_000_000))
+        encFmt.setInteger(MediaFormat.KEY_FRAME_RATE, fps)
+        encFmt.setInteger(MediaFormat.KEY_I_FRAME_INTERVAL, 1)
+        val encoder = MediaCodec.createEncoderByType(MediaFormat.MIMETYPE_VIDEO_AVC)
+        encoder.configure(encFmt, null, null, MediaCodec.CONFIGURE_FLAG_ENCODE)
+        encoder.start()
+
+        val muxer = MediaMuxer(outFile.absolutePath, MediaMuxer.OutputFormat.MUXER_OUTPUT_MPEG_4)
+        muxer.setOrientationHint(rotation)
+        var muxerStarted = false
+        var encVideoTrack = -1
+        var encAudioTrack = -1
+        val xOff = (width - side) / 2
+        val yOff = (height - side) / 2
+
+        extractor.selectTrack(videoTrack)
+        val info = MediaCodec.BufferInfo()
+        val encInfo = MediaCodec.BufferInfo()
+        var inEos = false
+        var decEos = false
+        var encEos = false
+        var spins = 0
+        val yuv = ByteArray(side * side * 3 / 2)
+        while (!encEos && spins++ < 30_000) {
+            if (!inEos) {
+                val inIx = decoder.dequeueInputBuffer(TIMEOUT_US)
+                if (inIx >= 0) {
+                    val buf = decoder.getInputBuffer(inIx)!!
+                    val n = extractor.readSampleData(buf, 0)
+                    if (n < 0) {
+                        decoder.queueInputBuffer(
+                            inIx, 0, 0, 0, MediaCodec.BUFFER_FLAG_END_OF_STREAM
+                        )
+                        inEos = true
+                    } else {
+                        decoder.queueInputBuffer(inIx, 0, n, extractor.sampleTime, 0)
+                        extractor.advance()
+                    }
+                }
+            }
+            if (!decEos) {
+                val outIx = decoder.dequeueOutputBuffer(info, TIMEOUT_US)
+                if (outIx >= 0) {
+                    val image = decoder.getOutputImage(outIx)
+                    if (image != null && info.size > 0) {
+                        cropYuv420(image, xOff, yOff, side, yuv)
+                        image.close()
+                        var queued = false
+                        while (!queued && !encEos) {
+                            drainEncoder(encoder, muxer, encInfo, { track ->
+                                encVideoTrack = track
+                                if (!muxerStarted) {
+                                    if (audioFormat != null) {
+                                        encAudioTrack = muxer.addTrack(audioFormat)
+                                    }
+                                    muxer.start()
+                                    muxerStarted = true
+                                }
+                            }, { encEos = true }, { encVideoTrack })
+                            val eIx = encoder.dequeueInputBuffer(TIMEOUT_US)
+                            if (eIx >= 0) {
+                                val eBuf = encoder.getInputBuffer(eIx)!!
+                                eBuf.clear()
+                                eBuf.put(yuv)
+                                val flags = if (info.flags and
+                                    MediaCodec.BUFFER_FLAG_END_OF_STREAM != 0
+                                ) {
+                                    MediaCodec.BUFFER_FLAG_END_OF_STREAM
+                                } else {
+                                    0
+                                }
+                                encoder.queueInputBuffer(
+                                    eIx, 0, yuv.size, info.presentationTimeUs, flags
+                                )
+                                queued = true
+                            }
+                        }
+                    } else {
+                        image?.close()
+                    }
+                    if (info.flags and MediaCodec.BUFFER_FLAG_END_OF_STREAM != 0) {
+                        decEos = true
+                    }
+                    decoder.releaseOutputBuffer(outIx, false)
+                }
+            } else {
+                drainEncoder(encoder, muxer, encInfo, { track ->
+                    encVideoTrack = track
+                    if (!muxerStarted) {
+                        if (audioFormat != null) {
+                            encAudioTrack = muxer.addTrack(audioFormat)
+                        }
+                        muxer.start()
+                        muxerStarted = true
+                    }
+                }, { encEos = true }, { encVideoTrack })
+            }
+        }
+
+        if (audioTrack >= 0 && muxerStarted && encAudioTrack >= 0) {
+            extractor.unselectTrack(videoTrack)
+            extractor.selectTrack(audioTrack)
+            extractor.seekTo(0, MediaExtractor.SEEK_TO_CLOSEST_SYNC)
+            val aBuf = ByteBuffer.allocate(64 * 1024)
+            val aInfo = MediaCodec.BufferInfo()
+            while (true) {
+                aBuf.clear()
+                val n = extractor.readSampleData(aBuf, 0)
+                if (n < 0) break
+                aInfo.offset = 0
+                aInfo.size = n
+                aInfo.presentationTimeUs = extractor.sampleTime
+                aInfo.flags = extractor.sampleFlags
+                muxer.writeSampleData(encAudioTrack, aBuf, aInfo)
+                extractor.advance()
+            }
+        }
+
+        encoder.stop()
+        encoder.release()
+        decoder.stop()
+        decoder.release()
+        muxer.stop()
+        muxer.release()
+        extractor.release()
+    }
+
+    private fun drainEncoder(
+        encoder: MediaCodec,
+        muxer: MediaMuxer,
+        info: MediaCodec.BufferInfo,
+        onFormat: (Int) -> Unit,
+        onEos: () -> Unit,
+        videoTrack: () -> Int,
+    ) {
+        while (true) {
+            val outIx = encoder.dequeueOutputBuffer(info, 0)
+            when {
+                outIx == MediaCodec.INFO_OUTPUT_FORMAT_CHANGED -> {
+                    onFormat(muxer.addTrack(encoder.outputFormat))
+                }
+                outIx >= 0 -> {
+                    val buf = encoder.getOutputBuffer(outIx)!!
+                    if (info.flags and MediaCodec.BUFFER_FLAG_CODEC_CONFIG != 0) {
+                        info.size = 0
+                    }
+                    val track = videoTrack()
+                    if (info.size > 0 && track >= 0) {
+                        buf.position(info.offset)
+                        buf.limit(info.offset + info.size)
+                        muxer.writeSampleData(track, buf, info)
+                    }
+                    encoder.releaseOutputBuffer(outIx, false)
+                    if (info.flags and MediaCodec.BUFFER_FLAG_END_OF_STREAM != 0) {
+                        onEos()
+                        return
+                    }
+                }
+                else -> return
+            }
+        }
+    }
+
+    private fun cropYuv420(
+        image: android.media.Image,
+        xOff: Int,
+        yOff: Int,
+        side: Int,
+        out: ByteArray,
+    ) {
+        val yPlane = image.planes[0]
+        val uPlane = image.planes[1]
+        val vPlane = image.planes[2]
+        val yRow = yPlane.rowStride
+        val yPix = yPlane.pixelStride
+        val yBuf = yPlane.buffer
+        var o = 0
+        for (row in 0 until side) {
+            val y = yOff + row
+            for (col in 0 until side) {
+                val x = xOff + col
+                out[o++] = yBuf.get(y * yRow + x * yPix)
+            }
+        }
+        val uvSide = side / 2
+        val uRow = uPlane.rowStride
+        val uPix = uPlane.pixelStride
+        val vRow = vPlane.rowStride
+        val vPix = vPlane.pixelStride
+        val uBuf = uPlane.buffer
+        val vBuf = vPlane.buffer
+        // NV12: UV interleaved
+        for (row in 0 until uvSide) {
+            val y = yOff / 2 + row
+            for (col in 0 until uvSide) {
+                val x = xOff / 2 + col
+                out[o++] = uBuf.get(y * uRow + x * uPix)
+                out[o++] = vBuf.get(y * vRow + x * vPix)
+            }
+        }
+    }
+}
