+    /**
+     * @return true if the event is fully handled (do not dispatch further)
+     */
+    private boolean handleHwCalcKey(KeyEvent event) {
+        final int keyCode = event.getKeyCode();
+        if (isSystemOrNavKey(keyCode) || event.isSystem()) {
+            return false;
+        }
+        final boolean down = event.getAction() == KeyEvent.ACTION_DOWN;
+        if (event.getAction() == KeyEvent.ACTION_UP) {
+            // Consumed on down (including repeats). Swallow so IME cannot insert letters.
+            return true;
+        }
+        if (!down) {
+            return false;
+        }
+
+        if (isEqualsKey(keyCode, event)) {
+            if (event.getRepeatCount() == 0) {
+                stopActionModeOrContextMenu();
+                cancelUnrequested();
+                onEquals();
+            }
+            return true;
+        }
+        if (keyCode == KeyEvent.KEYCODE_DEL || keyCode == KeyEvent.KEYCODE_FORWARD_DEL) {
+            stopActionModeOrContextMenu();
+            cancelUnrequested();
+            onDelete();
+            return true;
+        }
+        if (keyCode == KeyEvent.KEYCODE_CLEAR) {
+            stopActionModeOrContextMenu();
+            cancelUnrequested();
+            onClear();
+            return true;
+        }
+
+        final int id = calcButtonForHwKey(keyCode, event);
+        if (id != View.NO_ID) {
+            stopActionModeOrContextMenu();
+            cancelUnrequested();
+            cancelIfEvaluating(false);
+            addExplicitKeyToExpr(id);
+            redisplayAfterFormulaChange();
+            return true;
+        }
+        // Letter / other printing key: swallow. Do not add unprocessed junk.
+        return true;
+    }
