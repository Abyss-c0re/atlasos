# project:frameworks/base
# Titan HW Enter on the password bouncer must submit, not cancel IME.
diff --git a/packages/SystemUI/src/com/android/keyguard/KeyguardPasswordViewController.java b/packages/SystemUI/src/com/android/keyguard/KeyguardPasswordViewController.java
index 4b46370ac1ff..355acfc3a180 100644
--- a/packages/SystemUI/src/com/android/keyguard/KeyguardPasswordViewController.java
+++ b/packages/SystemUI/src/com/android/keyguard/KeyguardPasswordViewController.java
@@ -78,12 +78,19 @@ public class KeyguardPasswordViewController
     private boolean mPaused;
 
     private final OnEditorActionListener mOnEditorActionListener = (v, actionId, event) -> {
-        // Check if this was the result of hitting the IME done action
+        // Soft IME Done/Next arrives with event == null. Hardware Enter on a
+        // shown IME arrives with event != null and was ignored — PocketBoard
+        // then treated it as cancel, so the password field never submitted.
         final boolean isSoftImeEvent = event == null
                 && (actionId == EditorInfo.IME_NULL
                 || actionId == EditorInfo.IME_ACTION_DONE
                 || actionId == EditorInfo.IME_ACTION_NEXT);
-        if (isSoftImeEvent) {
+        final boolean isKeyboardEnter = event != null
+                && event.getAction() == KeyEvent.ACTION_DOWN
+                && event.getRepeatCount() == 0
+                && KeyEvent.isConfirmKey(event.getKeyCode())
+                && event.getKeyCode() != KeyEvent.KEYCODE_SPACE;
+        if (isSoftImeEvent || isKeyboardEnter) {
             verifyPasswordAndUnlock();
             return true;
         }
@@ -92,9 +99,11 @@ public class KeyguardPasswordViewController
 
     private final View.OnKeyListener mKeyListener = (v, keyCode, keyEvent) -> {
         // Ignore SPACE as a confirm key to allow the space character within passwords.
+        // ACTION_DOWN: IME often FLAG_CANCELs the matching UP ("canceling the input").
         final boolean isKeyboardEnterKey = keyEvent != null
                 && KeyEvent.isConfirmKey(keyCode) && keyCode != KeyEvent.KEYCODE_SPACE
-                && keyEvent.getAction() == KeyEvent.ACTION_UP;
+                && keyEvent.getAction() == KeyEvent.ACTION_DOWN
+                && keyEvent.getRepeatCount() == 0;
         if (isKeyboardEnterKey) {
             verifyPasswordAndUnlock();
             return true;
@@ -170,6 +179,11 @@ public class KeyguardPasswordViewController
         mPasswordEntry.setKeyListener(TextKeyListener.getInstance());
         mPasswordEntry.setInputType(InputType.TYPE_CLASS_TEXT
                 | InputType.TYPE_TEXT_VARIATION_PASSWORD);
+        mPasswordEntry.setImeOptions(EditorInfo.IME_ACTION_DONE
+                | EditorInfo.IME_FLAG_NO_EXTRACT_UI
+                | EditorInfo.IME_FLAG_NO_FULLSCREEN);
+        // Titan printed keyboard. Soft IME on this field turns HW Enter into cancel.
+        mPasswordEntry.setShowSoftInputOnFocus(false);
 
         mView.onDevicePostureChanged(mPostureController.getDevicePosture());
 
@@ -289,9 +303,12 @@ public class KeyguardPasswordViewController
         if (!mKeyguardViewController.isBouncerShowing()) {
             return;
         }
-
+        // Titan: keep focus on the password field; do not raise PocketBoard.
+        // HW Enter must reach OnKeyListener / editor-action, not IME cancel.
         if (mView.isShown()) {
-            mView.showKeyboard();
+            mPasswordEntry.setShowSoftInputOnFocus(false);
+            mView.hideKeyboard();
+            mPasswordEntry.requestFocus();
         }
     }
 
