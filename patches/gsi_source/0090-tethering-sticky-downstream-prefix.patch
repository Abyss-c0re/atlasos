+    /**
+     * Titan 2: persist.sys.titan2.tether_ipv4 = "10.191.207.1/24" pins gateway
+     * for every tethering type (wifi/usb/ethernet). Empty = AOSP random sticky.
+     */
+    @Nullable
+    private LinkAddress titan2PinnedDownstream() {
+        final String raw = SystemProperties.get("persist.sys.titan2.tether_ipv4", "");
+        if (raw == null || raw.indexOf('/') < 0) return null;
+        try {
+            return new LinkAddress(raw.trim());
+        } catch (IllegalArgumentException e) {
+            return null;
+        }
+    }
