+    // Titan 2: sub_touch is DIRECT. Two INTERNAL viewports exist, and
+    // getDisplayViewportByType(INTERNAL) prefers the default display.
+    // An unbound rear digitizer then becomes the primary touchscreen
+    // (cube on the sub display stops receiving those touches).
+    // Port 3 is the rear panel. No port → disable, do not guess display 0.
+    if (getDeviceName() == "sub_touch") {
+        std::optional<DisplayViewport> rear = mConfig.getDisplayViewportByPort(3);
+        if (rear) {
+            return rear;
+        }
+        ALOGI("sub_touch has no rear viewport; refusing primary-display fallback");
+        return std::nullopt;
+    }
+
