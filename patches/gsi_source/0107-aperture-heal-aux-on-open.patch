index 0000000..b1c8e01
--- /dev/null
+++ b/app/src/main/java/org/lineageos/aperture/TitanAuxHeal.kt
@@ -0,0 +1,127 @@
+/*
+ * SPDX-FileCopyrightText: AtlasOS / Titan 2
+ * SPDX-License-Identifier: Apache-2.0
+ */
+
+package org.lineageos.aperture
+
+import android.content.Context
+import android.hardware.SensorPrivacyManager
+import android.hardware.camera2.CameraManager
+import android.os.SystemClock
+import android.util.Log
+import java.io.File
+import java.util.concurrent.CountDownLatch
+import java.util.concurrent.TimeUnit
+
+/**
+ * HI847S (id 2) is SYSTEM_CAMERA and often missing from the first CameraService
+ * enum after reboot. titan2-sensor-privacy publishes it (init recycle) when
+ * privacy is OFF. This is the on-open trigger so a human reboot does not
+ * depend on a boot-time race.
+ *
+ * Privacy ON: do nothing (fail-closed). Never recycle HAL under 000 nodes.
+ */
+object TitanAuxHeal {
+    private const val TAG = "TitanCam"
+    private const val AUX_ID = "2"
+    private const val WAKE = "/data/local/tmp/titan2_sp_wake"
+    private const val TOKEN = "cam_allow"
+    private const val DEBOUNCE_MS = 20_000L
+
+    @Volatile
+    private var lastRequestElapsed = 0L
+
+    fun cameraPrivacyOn(context: Context): Boolean {
+        val spm = context.getSystemService(SensorPrivacyManager::class.java) ?: return false
+        return try {
+            val two = spm.javaClass.methods.firstOrNull { m ->
+                m.name == "isSensorPrivacyEnabled" && m.parameterCount == 2
+            }
+            if (two != null) {
+                return two.invoke(spm, 1, SensorPrivacyManager.Sensors.CAMERA) as Boolean
+            }
+            val one = spm.javaClass.methods.firstOrNull { m ->
+                m.name == "isSensorPrivacyEnabled" &&
+                    m.parameterCount == 1 &&
+                    m.parameterTypes[0] == Int::class.javaPrimitiveType
+            }
+            if (one != null) {
+                return one.invoke(spm, SensorPrivacyManager.Sensors.CAMERA) as Boolean
+            }
+            false
+        } catch (t: Throwable) {
+            Log.w(TAG, "sensor privacy read failed", t)
+            false
+        }
+    }
+
+    fun cameraIds(context: Context): List<String> {
+        val cm = context.getSystemService(CameraManager::class.java) ?: return emptyList()
+        return try {
+            cm.cameraIdList.toList()
+        } catch (t: Throwable) {
+            Log.w(TAG, "cameraIdList failed", t)
+            emptyList()
+        }
+    }
+
+    fun hasAux(context: Context): Boolean = cameraIds(context).contains(AUX_ID)
+
+    fun requestIfNeeded(context: Context) {
+        if (cameraPrivacyOn(context)) {
+            Log.i(TAG, "aux heal skip (camera privacy ON)")
+            return
+        }
+        if (hasAux(context)) {
+            return
+        }
+        val now = SystemClock.elapsedRealtime()
+        if (now - lastRequestElapsed in 0 until DEBOUNCE_MS) {
+            return
+        }
+        lastRequestElapsed = now
+        try {
+            File(WAKE).writeText(TOKEN)
+            Log.i(TAG, "aux heal requested ($TOKEN) ids=${cameraIds(context)}")
+        } catch (t: Throwable) {
+            Log.w(TAG, "aux heal wake write failed", t)
+        }
+    }
+
+    fun awaitAux(context: Context, timeoutMs: Long = 40_000L): Boolean {
+        requestIfNeeded(context)
+        if (cameraPrivacyOn(context)) {
+            return false
+        }
+        if (hasAux(context)) {
+            return true
+        }
+        val cm = context.getSystemService(CameraManager::class.java) ?: return false
+        val latch = CountDownLatch(1)
+        val cb = object : CameraManager.AvailabilityCallback() {
+            override fun onCameraAvailable(cameraId: String) {
+                if (cameraId == AUX_ID) {
+                    latch.countDown()
+                }
+            }
+        }
+        return try {
+            cm.registerAvailabilityCallback(context.mainExecutor, cb)
+            val deadline = SystemClock.elapsedRealtime() + timeoutMs
+            while (SystemClock.elapsedRealtime() < deadline) {
+                if (hasAux(context)) {
+                    Log.i(TAG, "aux heal got id $AUX_ID")
+                    return true
+                }
+                latch.await(400, TimeUnit.MILLISECONDS)
+            }
+            val ok = hasAux(context)
+            Log.i(TAG, "aux heal timeout ok=$ok ids=${cameraIds(context)}")
+            ok
+        } catch (t: Throwable) {
+            Log.w(TAG, "aux heal wait failed", t)
+            hasAux(context)
+        } finally {
+            try {
+                cm.unregisterAvailabilityCallback(cb)
+            } catch (_: Throwable) {
+            }
+        }
+    }
+}
