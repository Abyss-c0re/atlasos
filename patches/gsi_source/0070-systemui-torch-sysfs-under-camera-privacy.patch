+    /** MTK sysfs torch — independent of CameraService device list / video nodes. */
+    private static boolean hasSysfsTorch() {
+        return new File("/sys/devices/virtual/flashlight_core/flashlight/flashlight_torch")
+                .exists()
+                || new File("/sys/class/flashlight_core/flashlight/flashlight_torch").exists();
+    }
+
+    private static boolean setTorchSysfs(boolean enabled) {
+        String[] paths = {
+                "/sys/devices/virtual/flashlight_core/flashlight/flashlight_torch",
+                "/sys/class/flashlight_core/flashlight/flashlight_torch",
+        };
+        String on = enabled ? "1" : "0";
+        for (String path : paths) {
+            File f = new File(path);
+            if (!f.exists()) continue;
+            try (FileWriter w = new FileWriter(f)) {
+                // type0 ct0 + ct1 (dual color temp)
+                w.write("0 0 0 " + on + "\n");
+                w.flush();
+            } catch (Throwable e) {
+                Log.e(TAG, "sysfs torch write failed " + path, e);
+                continue;
+            }
+            try (FileWriter w = new FileWriter(f)) {
+                w.write("0 1 0 " + on + "\n");
+                w.flush();
+            } catch (Throwable ignored) {
+            }
+            Log.i(TAG, "sysfs torch " + (enabled ? "on" : "off") + " via " + path);
+            return true;
+        }
+        return false;
+    }
