# Fail-closed camera / microphone when stock LOS sensor privacy is ON.
# Root via init (hybrid system image) — no Magisk / no app root.
# See docs/project/SENSOR_PRIVACY_SYSTEM.md

# HI847S (id 2) is SYSTEM_CAMERA. CameraProviderManager only publishes it
# when persist.sys.phh.include_all_cameras=true at first HAL/CameraService
# enum. Volatile aux packagelist must exist before camerahalserver starts.
# A +30s/+70s recycle is too late — human opens Aperture at boot.
on early-init
    setprop persist.sys.phh.include_all_cameras true
    setprop camera.aux.packagelist org.lineageos.aperture,com.google.android.apps.googlecamera.fishfood
    setprop vendor.camera.aux.packagelist org.lineageos.aperture,com.google.android.apps.googlecamera.fishfood
on init
    setprop persist.sys.phh.include_all_cameras true
    setprop camera.aux.packagelist org.lineageos.aperture,com.google.android.apps.googlecamera.fishfood
    setprop vendor.camera.aux.packagelist org.lineageos.aperture,com.google.android.apps.googlecamera.fishfood
on post-fs-data
    setprop persist.sys.phh.include_all_cameras true
    setprop camera.aux.packagelist org.lineageos.aperture,com.google.android.apps.googlecamera.fishfood
    setprop vendor.camera.aux.packagelist org.lineageos.aperture,com.google.android.apps.googlecamera.fishfood

service titan2-sensor-privacy /system/bin/titan2-sensor-privacy.sh
    class late_start
    user root
    group root system media audio camera

# One start path. Extra start titan2-sensor-privacy from boot_completed
# + dev.bootcomplete + persist fired a second script that killed the live
# belt mid-HI847S heal (v38). Script now yields if a belt is already up.
# Keep only late_start + belt kill-switch (restore leftover 000).
on property:persist.titan2.privacy_belt=*
    start titan2-sensor-privacy

# HI847S: shell setprop ctl.restart/ctl.stop from this service does not
# recycle CameraService (lab T2031Z). Init stop/start does.
on property:sys.titan2.aux_pub=1
    stop cameraserver
    stop camerahalserver
    setprop persist.sys.phh.include_all_cameras true
    setprop camera.aux.packagelist org.lineageos.aperture,com.google.android.apps.googlecamera.fishfood
    setprop vendor.camera.aux.packagelist org.lineageos.aperture,com.google.android.apps.googlecamera.fishfood
on property:sys.titan2.aux_pub=2
    start camerahalserver
on property:sys.titan2.aux_pub=3
    start cameraserver
