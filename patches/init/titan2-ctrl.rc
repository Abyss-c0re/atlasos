# Titanus2 OS control plane — /data/misc/titan2
# Shared durable state for pad-agent, USB HID, Titan Controls (not user storage).
# Apps can rewrite existing 0666 files but often cannot *create* new ones (SELinux).
# titan2-ctrl-seed.sh pre-touches 0666 shells (pad off, HID session 0) if missing.
# Late phase pins pad QS tile after SystemUI is up.

on post-fs-data
    mkdir /data/misc/titan2 0777 system system
    chmod 0777 /data/misc/titan2

on boot
    mkdir /data/misc/titan2 0777 system system
    chmod 0777 /data/misc/titan2
    exec_background - root root -- /system/bin/sh /system/bin/titan2-ctrl-seed.sh early

on property:sys.boot_completed=1
    exec_background - root root -- /system/bin/sh /system/bin/titan2-ctrl-seed.sh late
