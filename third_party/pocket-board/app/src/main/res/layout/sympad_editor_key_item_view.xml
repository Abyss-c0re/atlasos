<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?colorPrimarySurface"
    android:layout_margin="@dimen/sympad_editor_item_margin">

    <TextView
        android:id="@+id/sympadKeyLabel"
        android:layout_width="@dimen/button_size"
        android:layout_height="@dimen/button_size"
        android:layout_margin="8dp"
        android:backgroundTint="@drawable/touch_color_selector"
        android:background="@drawable/meta_button"
        android:textColor="@drawable/touch_color_selector"
        android:textSize="@dimen/button_text_size"
        android:textStyle="bold"
        android:includeFontPadding="false"
        android:layout_gravity="center"
        android:gravity="center"
        tools:ignore="SpUsage" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <FrameLayout
            android:id="@+id/sympadKeyActionWrapper"
            android:layout_width="@dimen/button_size"
            android:layout_height="@dimen/button_size"
            android:layout_margin="8dp"
            android:backgroundTint="@drawable/touch_color_selector"
            android:background="@drawable/sympad_action_background">

            <TextView
                android:id="@+id/sympadKeyAction"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:textColor="?colorPrimarySurface"
                android:textSize="@dimen/button_text_size"
                android:textStyle="bold"
                android:includeFontPadding="false"
                android:gravity="center"
                android:layout_margin="4dp"
                tools:ignore="SpUsage" />

        </FrameLayout>

        <TextView
            android:id="@+id/sympadKeyValue"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="@dimen/sympad_editor_item_padding"
            android:gravity="start|center_vertical"
            android:textColor="?colorButtonNormal"
            android:textSize="@dimen/sympad_editor_item_text_size"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:ellipsize="end" />

    </LinearLayout>

</LinearLayout>